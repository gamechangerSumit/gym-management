# Copy to .env and fill in. NEVER commit .env.
# --- Database ---
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=12345678

# --- Backend ---
# Public URL members/staff use (used to build invite and reset links), no trailing slash.
APP_PUBLIC_BASE_URL=http://localhost:8080
# Base64 of 32 random bytes:  openssl rand -base64 32     (REQUIRED in prod; losing it invalidates stored QR copies)
APP_QR_ENC_KEY=HXq5ZMSre3lwfCngrR6j6PNyomMgLRrT3IdVRfYk+Aw=
# First owner account, created only if no owner exists. Password must be set; it must be changed at first login.
APP_BOOTSTRAP_OWNER_LOGIN=owner
APP_BOOTSTRAP_OWNER_PASSWORD=Gym@Owner2026
# true over HTTPS (prod); false only for plain-HTTP local runs.
APP_COOKIE_SECURE=false
# dev | prod | demo (demo seeds sample data; refuses to run with prod)
SPRING_PROFILES_ACTIVE=prod
